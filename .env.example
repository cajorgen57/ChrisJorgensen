# ============================================================================
# Personal Finance + Fitness Tracker — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ============================================================================

# ---- Plaid ----
# Sign up at https://dashboard.plaid.com/ and create an app.
# Start with "sandbox" while developing; switch to "development" for real
# accounts (free for up to 100 items) and "production" only if needed.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Comma-separated. Common picks: transactions,investments,liabilities
PLAID_PRODUCTS=transactions,investments
# Comma-separated ISO country codes
PLAID_COUNTRY_CODES=US
# Shown in the Link UI
PLAID_CLIENT_NAME=Chris Personal Tracker
# Optional: webhook URL for transaction updates (must be publicly reachable;
# leave blank for local-only use and rely on manual sync).
PLAID_WEBHOOK_URL=

# ---- Database ----
# Local SQLite by default. The file lives at prisma/dev.db and is gitignored.
DATABASE_URL="file:./dev.db"

# ---- App ----
# Used to sign session cookies / encrypt access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Where the app runs locally
NEXT_PUBLIC_APP_URL=http://localhost:3000
